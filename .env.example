# Kopiera till .env och fyll i. Se docs/drift.md.

# Proxyn framför Maya: caddy (standard) eller traefik.
COMPOSE_PROFILES=caddy
# Domänen som proxyn skaffar certifikat för. Samma värd som i MAYA_PUBLIC_URL.
MAYA_DOMAIN=bokforing.example.se
# Bara för Traefik: e-post till Let's Encrypt.
MAYA_ACME_EPOST=

# Mayas publika adress (krävs). Väljs före första start, eftersom passkeys binds till den.
MAYA_PUBLIC_URL=https://bokforing.example.se

# Backupmål (krävs): en katalog, monterad på /backup, på en annan disk än databasen ...
MAYA_BACKUP_DIR=/backup
MAYA_BACKUP_HOST_DIR=./backup
# ... eller S3-kompatibel lagring (ta då bort MAYA_BACKUP_DIR).
# MAYA_BACKUP_S3_ENDPOINT=https://s3.example.se
# MAYA_BACKUP_S3_BUCKET=maya
# MAYA_BACKUP_S3_REGION=us-east-1
# MAYA_BACKUP_S3_ACCESS_KEY_ID=
# MAYA_BACKUP_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3
# Klockslag för den nattliga backupen, i Europe/Stockholm.
# MAYA_BACKUP_TIME=03:00

# SMTP för larm till driften (valfritt). Hemligheter kan läsas ur en fil med _FILE.
# MAYA_SMTP_HOST=smtp.example.se
# MAYA_SMTP_PORT=587
# MAYA_SMTP_USERNAME=
# MAYA_SMTP_PASSWORD_FILE=/run/secrets/smtp
# MAYA_SMTP_FROM=maya@example.se
# MAYA_DRIFT_EPOST=drift@example.se

# Arkivplanens fritext: det Maya inte kan veta själv. Utan PLATS (plats och land) visar
# Att göra en driftvarning.
MAYA_ARKIVPLAN_PLATS=
MAYA_ARKIVPLAN_OFFSITE=
MAYA_ARKIVPLAN_NYCKEL=
MAYA_ARKIVPLAN_ANSVARIG=
