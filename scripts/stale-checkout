#!/usr/bin/env bash
# Checks whether this script's checkout is behind origin/main, since repo docs, skills and
# scripts read from it may then be stale.
# Usage: scripts/stale-checkout             SessionStart hook: warns, always exits 0
#        scripts/stale-checkout --require   guard for other scripts: fails when the checkout is
#                                           already merged into origin/main and behind it
set -uo pipefail

cd "$(dirname "$0")" || exit 0
# As a hook, check the session's own folder: $CLAUDE_PROJECT_DIR is the main checkout even
# when the session runs in a worktree. The hook input on stdin carries that folder as cwd.
if [ -z "${1:-}" ] && [ ! -t 0 ]; then
  cwd=$(jq -r '.cwd // empty' 2>/dev/null || true)
  [ -n "$cwd" ] && [ -d "$cwd" ] && cd "$cwd"
fi
# The hook's own timeout in .claude/settings.json bounds a slow fetch.
GIT_TERMINAL_PROMPT=0 git fetch -q origin main 2>/dev/null || exit 0
branch=$(git symbolic-ref --short -q HEAD) || exit 0
behind=$(git rev-list --count HEAD..origin/main 2>/dev/null) || exit 0
[ "$behind" -gt 0 ] || exit 0

if git merge-base --is-ancestor HEAD origin/main; then
  if [ "${1:-}" = "--require" ]; then
    echo "stale-checkout: $(git rev-parse --show-toplevel) is on '$branch', already merged into origin/main and $behind commits behind it, so its scripts are stale. Run the script from a worktree cut from origin/main." >&2
    exit 1
  fi
  state="is already merged into origin/main and is $behind commits behind it"
else
  [ "${1:-}" = "--require" ] && exit 0
  state="is $behind commits behind origin/main"
fi
echo "This session's checkout is on '$branch', which $state. Docs, skills and scripts here may be stale: read them with 'git show origin/main:<path>', or work in a worktree cut from origin/main."
